{
  "name": "howmuchah",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run tests/domain.test.ts tests/money.test.ts",
    "test:rules": "firebase emulators:exec --project demo-howmuchah --only firestore \"vitest run tests/firestore-rules.test.ts\"",
    "emulators": "firebase emulators:start --project demo-howmuchah",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "firebase-tools": "^15.34.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
