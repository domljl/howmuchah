{
  "name": "howmuchah",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.api.json --noEmit",
    "test": "vitest run tests/domain.test.ts tests/money.test.ts tests/api.test.ts tests/invite.test.ts",
    "api:dev": "tsx watch server/src/index.ts",
    "api:start": "node api-dist/server/src/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.1",
    "@clerk/react": "^6.18.0",
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.7",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
