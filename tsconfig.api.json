{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "api-dist",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.api.tsbuildinfo"
  },
  "include": ["server/src", "shared/domain.ts"]
}
